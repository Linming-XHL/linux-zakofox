diff --git a/include/linux/tick.h b/include/linux/tick.h
index b121c5d..ea7002a 100644
--- a/include/linux/tick.h
+++ b/include/linux/tick.h
@@ -172,7 +172,7 @@ extern cpumask_var_t tick_nohz_full_mask;
